{
  "name": "@intentface/ui",
  "version": "0.8.0",
  "description": "Headless UI primitives — unstyled compound components, hooks, and wire formats for AI chat interfaces and the app shells around them.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "Intentface",
  "homepage": "https://ui.intentface.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intentface/intentface-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Intentface/intentface-ui/issues"
  },
  "keywords": [
    "react",
    "chat",
    "ai",
    "headless",
    "ui",
    "components",
    "composer",
    "ai-sdk",
    "shell",
    "sidebar",
    "tabs",
    "nav"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./composer": {
      "types": "./dist/composer/index.d.ts",
      "default": "./dist/composer/index.js"
    },
    "./chip": {
      "types": "./dist/chip/index.d.ts",
      "default": "./dist/chip/index.js"
    },
    "./thread": {
      "types": "./dist/thread/index.d.ts",
      "default": "./dist/thread/index.js"
    },
    "./reasoning": {
      "types": "./dist/reasoning/index.d.ts",
      "default": "./dist/reasoning/index.js"
    },
    "./steps": {
      "types": "./dist/steps/index.d.ts",
      "default": "./dist/steps/index.js"
    },
    "./attachments": {
      "types": "./dist/attachments/index.d.ts",
      "default": "./dist/attachments/index.js"
    },
    "./ask-user": {
      "types": "./dist/ask-user/index.d.ts",
      "default": "./dist/ask-user/index.js"
    },
    "./message": {
      "types": "./dist/message/index.d.ts",
      "default": "./dist/message/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "default": "./dist/shell/index.js"
    },
    "./nav": {
      "types": "./dist/nav/index.d.ts",
      "default": "./dist/nav/index.js"
    },
    "./tabs": {
      "types": "./dist/tabs/index.d.ts",
      "default": "./dist/tabs/index.js"
    },
    "./message-utils": {
      "types": "./dist/message-utils.d.ts",
      "default": "./dist/message-utils.js"
    },
    "./chip-markdown": {
      "types": "./dist/chip-markdown.d.ts",
      "default": "./dist/chip-markdown.js"
    },
    "./generative": {
      "types": "./dist/generative/index.d.ts",
      "default": "./dist/generative/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/add-dist-extensions.mjs && node scripts/smoke-dist.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify:release": "bun run typecheck && bun test && bun run build && publint",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "publint": "0.3.23",
    "typescript": "^5",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
